# Runtime-only identity settings. Values below are placeholders, never credentials.
# Load alongside the documented development database settings.
# Switch to clerk only after filling every required Clerk setting from the selected instance.
IDENTITY_ADAPTER=disabled
CLERK_ISSUER=https://REPLACE_INSTANCE.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
CLERK_JWT_KEY=REPLACE_PEM_PUBLIC_KEY
# Optional, only when the instance issues the corresponding audience claim:
# CLERK_AUDIENCE=REPLACE_AUDIENCE
# No Clerk key is needed for a production build or foundation-only disabled mode.
