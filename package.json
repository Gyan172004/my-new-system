{
  "name": "dsa-interview-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "config:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "build": "node --import tsx scripts/build-migration-manifest.ts && next build && node scripts/build-server.mjs",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env.local --import tsx src/server/bootstrap.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.local dist/server.mjs",
    "check:architecture": "node --import tsx scripts/check-boundaries.ts",
    "test:architecture": "vitest run tests/architecture",
    "test:process": "vitest run tests/process",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "db:test": "node --import tsx scripts/test-database.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test:ci": "vitest run tests/ci",
    "verify:ci": "node --import tsx scripts/verify-ci.ts",
    "security:install": "node --import tsx scripts/security.ts install",
    "scan:secrets": "node --import tsx scripts/security.ts secrets",
    "scan:filesystem": "node --import tsx scripts/security.ts filesystem",
    "scan:image": "node --import tsx scripts/security.ts image",
    "container:build": "node --import tsx scripts/build-container.ts",
    "verify:foundation": "node --import tsx scripts/verify-foundation.ts",
    "verify:ci-failures": "node --import tsx scripts/verify-ci-negative-controls.ts",
    "verify:architecture": "npm run check:architecture && npm run test:architecture",
    "coverage:identity": "APP_ENV=test vitest run --config vitest.identity.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/backend": "3.25.0",
    "@clerk/nextjs": "7.9.17",
    "next": "16.4.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.47",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
